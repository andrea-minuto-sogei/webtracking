{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Web Tracking Apache Module Build",
      "command": "make",
      "args": [
        "all"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Web Tracking Apache Module Archives",
      "command": "make",
      "args": [
        "archives"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    }
  ]
}
